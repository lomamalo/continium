{
  "manifest_version": 2,
  "name": "Passerelle",
  "version": "0.1.0",
  "description": "Envoie la page courante (et la position YouTube) au tampon Passerelle sur ton PC. Conçu par Malo Lemoine.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "http://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "passerelle-continuity@local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Passerelle"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Malo Lemoine"
}
